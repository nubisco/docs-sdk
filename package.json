{
  "name": "@nubisco/docs-sdk",
  "version": "0.1.1",
  "description": "The Nubisco documentation design as a package: VitePress, the theme, the plugins and a config helper, so a product supplies only its content.",
  "license": "MIT",
  "author": "José Silva <jose@nubisco.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/docs-sdk.git"
  },
  "homepage": "https://github.com/nubisco/docs-sdk#readme",
  "bugs": "https://github.com/nubisco/docs-sdk/issues",
  "type": "module",
  "bin": {
    "nubisco-docs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": "./src/theme/index.ts",
    "./package.json": "./package.json",
    "./plugins/*": "./src/plugins/*"
  },
  "files": [
    "dist",
    "src/theme",
    "src/plugins",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "pnpm run build && node dist/cli.js dev fixture/docs",
    "docs:build": "pnpm run build && node dist/cli.js build fixture/docs",
    "test": "vitest run",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "quality:check": "pnpm run test && pnpm run types:check && pnpm run format:check && pnpm run docs:build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.13.0",
    "sass-embedded": "^1.98.0",
    "vite-svg-loader": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.1"
  },
  "peerDependencies": {
    "@nubisco/ui": "^5.40.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nubisco/ui": "^5.40.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^2.0.12",
    "@types/node": "^22.0.0",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "markdown-it": "^14.3.3",
    "prettier": "^3.3.0",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "vue": "^3.5.30"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/joseporto"
    }
  ],
  "keywords": [
    "vitepress",
    "documentation",
    "docs",
    "theme",
    "nubisco",
    "design-system"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm exec prettier --check . && pnpm run test",
    "pre-push": "pnpm run quality:check"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
